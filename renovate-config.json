{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for repositories in the patchlevel organisation",
  "extends": [
    ":dependencyDashboard",
    ":ignoreModulesAndTests",
    ":rebaseStalePrs",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":enableVulnerabilityAlerts",
    ":timezone(UTC)",
    ":gitSignOff",
    ":label(renovate)",
    ":automergeMinor",
    ":automergeBranch",
    ":prNotPending",
    ":semanticCommitsDisabled",
    "group:monorepos",
    "group:recommended",
    "security:minimumReleaseAgeNpm"
  ],
  "prHourlyLimit": 2,
  "branchConcurrentLimit": 10,
  "commitBodyTable": true,
  "configMigration": true,
  "enabledManagers": [
    "composer",
    "github-actions",
    "terraform",
    "dockerfile",
    "docker-compose",
    "helmv3",
    "helm-values",
    "npm"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:weekly"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "platformAutomerge": true,
  "rangeStrategy": "replace",
  "rollbackPrs": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "php"
      ],
      "extends": [
        ":automergeDisabled",
        ":automergePr"
      ],
      "ignoreUnstable": false,
      "groupName": "PHP",
      "rangeStrategy": "widen"
    },
    {
      "matchDepTypes": [
        "require"
      ],
      "rangeStrategy": "widen"
    },
    {
      "matchPackageNames": [
        "symfony/**"
      ],
      "groupSlug": "symfony",
      "groupName": "Symfony packages"
    },
    {
      "description": "Minor bumps of 0.x packages are breaking, review them by hand",
      "matchCurrentVersion": "/^0\\./",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Majors wait for a review, rebasing them after every merge to the base branch only burns CI minutes",
      "matchUpdateTypes": [
        "major"
      ],
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupSlug": "github-actions",
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": [
        "unified",
        "remark",
        "remark-*",
        "rehype",
        "rehype-*"
      ],
      "groupSlug": "unified",
      "groupName": "unified packages"
    }
  ]
}
